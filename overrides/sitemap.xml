<?xml version="1.0" encoding="UTF-8"?>
<!--
  Interim sitemap override for Zensical: its template context passes page objects in
  `pages` (not MkDocs files), so the old `file.page` loop failed. Emits <loc> only;
  restoring <lastmod> from git commit dates is a separate task (see the plan, Task 4).
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in pages -%}
    {% if page.canonical_url %}
    <url>
         <loc>{{ page.canonical_url|e }}</loc>
    </url>
    {%- endif -%}
{% endfor %}
</urlset>
